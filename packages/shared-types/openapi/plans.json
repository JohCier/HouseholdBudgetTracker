  "components" : {
    "schemas" : {
      "AddExpenseRequest" : {
        "required" : [ "amount", "category", "description", "period" ],
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "format" : "decimal",
            "example" : "850.0"
          },
          "category" : {
            "$ref" : "#/components/schemas/ExpenseCategory"
          },
          "description" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "important" : {
            "type" : "boolean",
            "description" : "Optional, only to restore a removed item; a new expense is not important",
            "nullable" : true
          },
          "note" : {
            "maxLength" : 1000,
            "minLength" : 0,
            "type" : "string",
            "description" : "Optional; empty or blank means no note",
            "nullable" : true
          },
          "period" : {
            "$ref" : "#/components/schemas/AmountPeriod"
          },
          "savingPotential" : {
            "type" : "string",
            "description" : "Optional, only to restore a removed item: the monthly saving potential, at most the monthly amount",
            "format" : "decimal",
            "nullable" : true,
            "example" : "5.0"
          },
          "subcategory" : {
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string",
            "description" : "Optional; empty or blank means none, i.e. \"Sonstiges\"",
            "nullable" : true
          }
        }
      },
      "AddIncomeRequest" : {
        "required" : [ "amount", "description", "period" ],
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "format" : "decimal",
            "example" : "2500.0"
          },
          "description" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "important" : {
            "type" : "boolean",
            "description" : "Optional, only to restore a removed item; a new income is not important",
            "nullable" : true
          },
          "note" : {
            "maxLength" : 1000,
            "minLength" : 0,
            "type" : "string",
            "description" : "Optional; empty or blank means no note",
            "nullable" : true
          },
          "period" : {
            "$ref" : "#/components/schemas/AmountPeriod"
          },
          "subcategory" : {
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string",
            "description" : "Optional; empty or blank means none, i.e. \"Sonstiges\"",
            "nullable" : true
          }
        }
      },
      "AddedBudgetItemResponse" : {
        "required" : [ "id", "overview" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "overview" : {
            "$ref" : "#/components/schemas/HouseholdPlanOverviewResponse"
          }
        }
      },
      "AmountPeriod" : {
        "type" : "string",
        "enum" : [ "MONTHLY", "YEARLY" ]
      },
      "BudgetItemResponse" : {
        "required" : [ "amount", "annualAmount", "category", "description", "id", "important", "monthlyAmount", "note", "percentageOfGroup", "period", "savingPotential", "subcategory", "type" ],
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "description" : "As entered, a monthly or a yearly amount depending on period",
            "format" : "decimal",
            "example" : "850.0"
          },
          "annualAmount" : {
            "type" : "string",
            "format" : "decimal",
            "example" : "10200.0"
          },
          "category" : {
            "description" : "Only set for expenses",
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/ExpenseCategory"
            } ]
          },
          "description" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "important" : {
            "type" : "boolean"
          },
          "monthlyAmount" : {
            "type" : "string",
            "format" : "decimal",
            "example" : "850.0"
          },
          "note" : {
            "type" : "string",
            "description" : "Only set if the item has a note",
            "nullable" : true
          },
          "percentageOfGroup" : {
            "type" : "number",
            "description" : "Only set for the items of a group: how much of the group the item makes up per month, in percent (TK-8)",
            "nullable" : true,
            "example" : 80.0
          },
          "period" : {
            "$ref" : "#/components/schemas/AmountPeriod"
          },
          "savingPotential" : {
            "type" : "string",
            "description" : "The monthly saving potential; only set for expenses that have one",
            "format" : "decimal",
            "nullable" : true,
            "example" : "5.0"
          },
          "subcategory" : {
            "type" : "string",
            "description" : "Only set if the item has a subcategory; otherwise it is listed under \"Sonstiges\"",
            "nullable" : true
          },
          "type" : {
            "$ref" : "#/components/schemas/ItemType"
          }
        }
      },
      "CategoryBreakdownResponse" : {
        "required" : [ "actualPercentageOfIncome", "category", "monthlyTotal", "monthlyUnplanned", "targetDirection", "targetMet", "targetPercentageOfIncome", "total", "unplanned", "unplannedPercentageOfTotal" ],
        "type" : "object",
        "properties" : {
          "actualPercentageOfIncome" : {
            "type" : "number",
            "example" : 34.0
          },
          "category" : {
            "$ref" : "#/components/schemas/ExpenseCategory"
          },
          "monthlyTotal" : {
            "type" : "string",
            "description" : "Total per month: total divided by 12 (MJ-14)",
            "format" : "decimal",
            "example" : "70.83"
          },
          "monthlyUnplanned" : {
            "type" : "string",
            "description" : "Unplanned per month: unplanned divided by 12 (MJ-14)",
            "format" : "decimal",
            "example" : "0.0"
          },
          "targetDirection" : {
            "$ref" : "#/components/schemas/TargetDirection"
          },
          "targetMet" : {
            "type" : "boolean"
          },
          "targetPercentageOfIncome" : {
